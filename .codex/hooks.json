{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command|Edit|Write|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/session-contract-gate.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand ",
            "statusMessage": "Checking ADK session contract"
          }
        ]
      },
      {
        "matcher": "Bash|shell_command|Edit|Write|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/request-contract.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\" PreToolUse",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/session-inject.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand ",
            "statusMessage": "Loading ADK workflow state"
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/request-contract.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\" SessionStart",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$root/.agents/harness/session-contract-recovery.cjs\"; [ ! -f \"$hook\" ] || node \"$hook\" event SessionStart; exit 0",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/session-inject.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand ",
            "statusMessage": "Refreshing ADK workflow state"
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/request-contract.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\" UserPromptSubmit",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$root/.agents/harness/session-contract-recovery.cjs\"; [ ! -f \"$hook\" ] || node \"$hook\" event UserPromptSubmit; exit 0",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$root/.claude/hooks/sync-entry-points.js\"; [ ! -f \"$hook\" ] || node \"$hook\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$root/.claude/hooks/context-translation-batch.cjs\"; [ ! -f \"$hook\" ] || node \"$hook\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/request-contract.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\" PostToolUse",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/request-contract.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\" PreCompact",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$root/.codex/hooks/session-inject.cjs\"; [ ! -f \"$hook\" ] || node \"$hook\"",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand ",
            "statusMessage": "Restoring ADK workflow state"
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; registry=\"$root/.codex/hooks.json\"; [ ! -f \"$registry\" ] && exit 0; hook=\"$root/.codex/hooks/request-contract.cjs\"; if [ ! -f \"$hook\" ]; then echo \"Configured Codex hook is missing: $hook\" >&2; exit 1; fi; node \"$hook\" PostCompact",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "failure='{\"decision\":\"block\",\"reason\":\"[request-contract:stop_hook_unavailable] Stop contract check unavailable; lifecycle continues for repair.\"}'; emit(){ printf '%s' \"$failure\"; }; root=$(git rev-parse --show-toplevel 2>/dev/null) || { emit; exit 0; }; registry=\"$root/.codex/hooks.json\"; [ -f \"$registry\" ] || { emit; exit 0; }; hook=\"$root/.codex/hooks/request-contract.cjs\"; [ -f \"$hook\" ] || { emit; exit 0; }; node \"$hook\" Stop || emit; exit 0",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$root/.claude/hooks/context-translation-batch.cjs\"; [ ! -f \"$hook\" ] || node \"$hook\" --flush || echo \"[context-translation] Stop flush deferred for retry\" >&2; exit 0",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$root/.agents/harness/session-contract-recovery.cjs\"; [ ! -f \"$hook\" ] || node \"$hook\" event Stop; exit 0",
            "commandWindows": "powershell -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ]
  }
}
