{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/request-contract.js", "PreToolUse"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pr-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/destructive-git-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/commit-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/deploy-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/git-push-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/email-send-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/gcs-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/rdd-experiment-guard.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/design-doc-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/prod-gateway-guard.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/beh-pretool.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/beh-session-start.js"
          },
          {
            "type": "command",
              "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/request-contract.js", "SessionStart"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
              "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/request-contract.js", "UserPromptSubmit"]
          },
          {
            "type": "command",
            "command": "node .claude/hooks/session-inject.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/beh-tick.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/sync-entry-points.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/cascade-check.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/agents-context-mirror.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/context-translation-batch.cjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/ctx-index-rebuild.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
              "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/request-contract.js", "PostToolUse"]
          },
          {
            "type": "command",
            "command": "node .claude/hooks/beh-record.js"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/request-contract.js", "PreCompact"]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-compact-context.js"
          },
          {
            "type": "command",
              "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/request-contract.js", "PostCompact"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
              "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/request-contract.js", "Stop"]
          },
          {
            "type": "command",
            "command": "node .claude/hooks/beh-stop.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/context-translation-batch.cjs --flush"
          }
        ]
      }
    ]
  }
}
