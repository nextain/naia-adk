{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextain.io/schemas/lightweight-session-contract-v1.json",
  "title": "Naia ADK Lightweight Session Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "project_root",
    "goal",
    "scope",
    "non_goals",
    "success_criteria",
    "allowed_paths",
    "target_ownership",
    "audiences",
    "source_refs",
    "session_bindings",
    "progress_file",
    "contract_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "closed"] },
    "project_root": { "const": "." },
    "goal": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "success_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^*]+(?:/\\*\\*)?$"
      }
    },
    "target_ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^*]+(?:/\\*\\*)?$"
      }
    },
    "audiences": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowed_shell_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" }
    },
    "session_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "contract_digest"],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "contract_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "progress_file": { "type": "string", "pattern": "^\\.agents/progress/[^/]+\\.json$" },
    "contract_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
