{
  "$comment": "Configuration for drift-guard hooks (.claude/hooks/artifact-drift-guard.js, .claude/hooks/copy-file-guard.js, .claude/hooks/stale-uncommitted-notice.js). Guide: docs/guides/drift-guard.md.",
  "artifact_extensions": [
    ".nva",
    ".exe",
    ".msi",
    ".dmg",
    ".AppImage",
    ".apk",
    ".vrm"
  ],
  "artifact_script_dirs": [
    "naia-labs/avatar",
    "naia-labs/**/service",
    "scripts/build*"
  ],
  "code_extensions": [
    ".py",
    ".ts",
    ".tsx",
    ".js",
    ".mjs",
    ".cjs",
    ".rs",
    ".go",
    ".sh"
  ],
  "allowed_numeric_stems": [
    "oauth1",
    "oauth2",
    "http1",
    "http2",
    "http3",
    "md5",
    "sha1",
    "sha224",
    "sha256",
    "sha384",
    "sha512",
    "blake2",
    "blake3",
    "crc32",
    "base16",
    "base32",
    "base58",
    "base62",
    "base64",
    "utf8",
    "utf16",
    "utf32",
    "i18n",
    "l10n",
    "g11n",
    "a11y",
    "o11y",
    "k8s",
    "p2p",
    "b2b",
    "b2c",
    "e2e",
    "web3",
    "webgl2",
    "ipv4",
    "ipv6",
    "x86",
    "x64",
    "arm64",
    "aarch64",
    "wasm32",
    "wasm64",
    "win32",
    "win64",
    "int8",
    "int16",
    "int32",
    "int64",
    "uint8",
    "uint16",
    "uint32",
    "uint64",
    "float16",
    "float32",
    "float64"
  ],
  "stale_uncommitted_hours": 4
}
