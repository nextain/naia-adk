[Unit]
Description=Refactor oversized workspace documents

[Service]
Type=oneshot
# Replace both paths with absolute paths for this workspace and Node executable.
Environment=DOC_SIZE_ROOT=/path/to/workspace
Environment=TMPDIR=/path/to/writable/temp
# systemd user services start with a minimal PATH. Include the directories holding
# node and codex, or set DOC_SIZE_CODEX to an absolute path; a Node-based codex
# launcher still needs node on PATH.
Environment=PATH=/path/to/node/bin:/usr/local/bin:/usr/bin
ExecStart=/path/to/node /path/to/workspace/scripts/doc-size-refactor.mjs
NoNewPrivileges=yes
PrivateTmp=yes
