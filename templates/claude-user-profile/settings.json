{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0",
    "CLAUDE_CODE_RETRY_WATCHDOG": "0"
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "\"{{NODE}}\" \"{{ADK_ROOT}}/.claude/hooks/destructive-git-guard.js\"" },
        { "type": "command", "command": "\"{{NODE}}\" \"{{ADK_ROOT}}/.claude/hooks/catastrophic-delete-guard.js\"" },
        { "type": "command", "command": "\"{{NODE}}\" \"{{ADK_ROOT}}/.claude/hooks/git-push-guard.js\"" },
        { "type": "command", "command": "\"{{NODE}}\" \"{{ADK_ROOT}}/.claude/hooks/email-send-guard.js\"" }
      ] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"{{NODE}}\" \"{{ADK_ROOT}}/.claude/hooks/role-compact-brief.js\"" }] }
    ]
  }
}
