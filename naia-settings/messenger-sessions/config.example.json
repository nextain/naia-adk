{
  "schemaVersion": 2,
  "enabled": false,
  "workspaceId": "replace-with-local-workspace-id",
  "workspace": {
    "path": ".",
    "agentId": "development-agent",
    "entrypoint": "AGENTS.md",
    "contextFiles": [
      ".agents/context/agents-rules.json",
      ".agents/context/ai-work-index.yaml",
      ".agents/context/project-index.yaml",
      ".agents/context/terminology.yaml"
    ],
    "issueTracker": {
      "provider": "github",
      "repo": "replace-with-owner/replace-with-repository"
    }
  },
  "persona": {
    "source": "naia-settings",
    "instructions": "Replace this line with what is true only for this instance: which guild and channel it answers in, which repository it owns, and what it must not touch. The identity itself comes from naia-settings/config.json, the same one the conversation agent uses."
  },
  "role": {
    "name": "issue-driven-development",
    "allowedActions": [
      "read",
      "reply",
      "write",
      "execute"
    ],
    "requiresApproval": []
  },
  "backend": {
    "selected": "opencode",
    "profiles": {
      "codex": {
        "enabled": true,
        "model": "gpt-5.6-luna",
        "reasoningEffort": "max",
        "costProfile": "balanced"
      },
      "claude": {
        "enabled": true
      },
      "opencode": {
        "enabled": true,
        "model": "azure-foundry/deepseek-v4-pro"
      }
    }
  },
  "discord": {
    "credentialRef": "discord-bot-token",
    "botUserId": "000000000000000000",
    "operatorUserIds": [
      "000000000000000000"
    ],
    "messageContentIntent": false,
    "participantProfiles": {
      "000000000000000000": {
        "label": "workspace-owner",
        "relationship": "Owner of this configured workspace",
        "allowedActions": [
          "read",
          "reply",
          "write",
          "execute",
          "cancel",
          "retry"
        ]
      }
    },
    "bindings": [
      {
        "kind": "guild_channel",
        "guildId": "000000000000000000",
        "channelId": "000000000000000000",
        "respondWhen": "mentioned",
        "allowedUserIds": [
          "000000000000000000"
        ],
        "historyVisibility": "shared",
        "canStartConversation": true,
        "operatorActions": true
      },
      {
        "kind": "dm",
        "userId": "000000000000000000",
        "respondWhen": "always",
        "allowedUserIds": [
          "000000000000000000"
        ],
        "historyVisibility": "requester_only",
        "canStartConversation": true,
        "operatorActions": true
      }
    ]
  },
  "runtime": {
    "softSilenceSeconds": 120,
    "noProgressInterventionSeconds": 120,
    "operatorResponseSeconds": 30,
    "heartbeatSeconds": 10,
    "approvalPolicy": "never",
    "permissionProfileEpoch": "replace-on-policy-change",
    "maxConcurrentJobs": 1,
    "networkAccess": true,
    "credentialProfiles": [
      "gh"
    ]
  },
  "observability": {
    "discordStatusProjection": false
  },
  "service": {
    "autoStart": true,
    "startAt": "login"
  },
  "recovery": {
    "autoRetry": true
  }
}
