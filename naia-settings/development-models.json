{
  "version": 1,
  "authority": { "runner": "codex", "responsibility": "workspace commands, integration decisions, and final file changes" },
  "roles": {
    "expert": { "runner": "codex", "model": "gpt-5.6-sol", "modelFamily": "gpt-5.6-sol", "reasoningEffort": "high", "purpose": "architecture, high-risk decisions, and design escalation" },
    "monitoring": { "runner": "codex", "model": "gpt-5.6-terra", "modelFamily": "gpt-5.6-terra", "reasoningEffort": "medium", "purpose": "normal monitoring and user communication" },
    "main": { "runner": "opencode", "model": "openrouter/tencent/hy3", "modelFamily": "hy3", "reasoningEffort": "high", "purpose": "development orchestration and implementation planning" },
    "sub": { "runner": "opencode", "model": "openrouter/tencent/hy3", "modelFamily": "hy3", "reasoningEffort": "medium", "purpose": "bounded implementation and verification" },
    "testing": { "runner": "opencode", "model": "openrouter/tencent/hy3", "modelFamily": "hy3", "reasoningEffort": "medium", "purpose": "focused test execution and test-result analysis; must use a separate executionId from implementation" },
    "translation": { "runner": "opencode", "model": "openrouter/tencent/hy3", "modelFamily": "hy3", "reasoningEffort": "low", "purpose": "bounded translation work only" },
    "adversarial_review": { "runner": "codex", "model": "gpt-5.6-terra", "modelFamily": "gpt-5.6-terra", "reasoningEffort": "high", "purpose": "Terra half of required independent adversarial review" },
    "adversarial_review_hy3": { "runner": "opencode", "model": "openrouter/tencent/hy3", "modelFamily": "hy3", "reasoningEffort": "high", "purpose": "HY3 half of required independent adversarial review" },
    "approval_boundary": { "runner": "external", "model": "approval-boundary", "modelFamily": "external-approval", "reasoningEffort": "external", "purpose": "external approval evidence verification only; shell and coding orchestrator cannot mint approval" },
    "integration": { "runner": "codex", "model": "codex-cli", "modelFamily": "codex-integration", "reasoningEffort": "high", "purpose": "privileged integration eligibility only; commit and push remain separate future actions" },
    "translation_verification": { "runner": "claude", "model": "haiku", "modelFamily": "claude-haiku", "purpose": "independent translation fidelity review" },
    "translation_review_hy3": { "runner": "opencode", "model": "openrouter/tencent/hy3", "modelFamily": "hy3", "reasoningEffort": "medium", "purpose": "independent translation context and terminology review; separate session from translation" }
  },
  "routes": {
    "design": "expert", "high_risk": "expert", "monitoring": "monitoring", "user_communication": "monitoring",
    "orchestration": "main", "implementation": "sub", "verification": "sub", "testing": "testing", "translation": "translation",
    "translation_review": ["translation_verification", "translation_review_hy3"], "translation_verification": "translation_verification", "adversarial_review": ["adversarial_review", "adversarial_review_hy3"],
    "external_approval_evidence": "approval_boundary", "integration": "integration"
  },
  "expertEscalation": {
    "mode": "automatic",
    "triggers": [
      "cross-repository contract or public API change",
      "security, permission, secret, or data-loss risk",
      "architecture choice with material alternatives",
      "repeated failure after the approved implementation path"
    ]
  }
}
