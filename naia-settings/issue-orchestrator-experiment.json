{
  "version": 1,
  "kind": "issue-scoped-coding-orchestrator-experiment",
  "shellMain": {
    "mode": "delegate-and-report-only",
    "executeCodingStages": false,
    "description": "shellMain coordinates and reports but cannot execute any coding stages; all execution is delegated to bound roles."
  },
  "roleBindings": {
    "design": "expert",
    "orchestration": "main",
    "implementation": "sub",
    "testing": "testing",
    "reviewTerra": "adversarial_review",
    "reviewHy3": "adversarial_review_hy3",
    "externalApproval": "approval_boundary",
    "integration": "integration"
  },
  "stages": [
    "design",
    "review_terra",
    "review_hy3",
    "orchestration",
    "external_approval_evidence",
    "plan",
    "implementation",
    "testing",
    "final_review_terra",
    "final_review_hy3",
    "integration"
  ],
  "reviewPolicy": {
    "requiredReviews": [
      "review_terra",
      "review_hy3"
    ],
    "mustAllBeClean": true,
    "description": "Both adversarial reviews (review_terra and review_hy3) must report all-clean for the pipeline to proceed.",
    "independence": {
      "implementationTesting": {
        "differentRole": true,
        "differentSessionId": true,
        "differentExecutionId": true
      },
      "hy3HighReviewOfHy3Medium": {
        "allowed": true,
        "differentSessionId": true,
        "differentExecutionId": true
      },
      "peerReviewers": {
        "differentSessionId": true,
        "differentExecutionId": true
      }
    }
  },
  "approvalPolicy": {
    "externallyVerifiedOnly": true,
    "identityProofRequired": false,
    "description": "Approval is verified only through external evidence; no identity proof is required or accepted."
  },
  "gateAuthority": {
    "eligibility": "naia-adk-deterministic-gate",
    "orchestratorMayScheduleOnlyFromGateReceipt": true,
    "shellMayPresentApprovalUiOnly": true,
    "realRunnerIncluded": false
  },
  "defectRoutes": {
    "implementation": "implementation",
    "instruction": "orchestration",
    "design": "design"
  }
}
