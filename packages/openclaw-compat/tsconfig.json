{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"composite": true
	},
	"include": ["src/**/*"],
	"exclude": ["src/__tests__/**", "dist", "node_modules"],
	"references": [
		{ "path": "../skill-spec" }
	]
}
