{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naia.dev/schemas/request-contract.schema.json",
  "title": "Request Contract",
  "description": "Complete source-to-evidence contract used by the request-contract integrity runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "status", "sources", "directives", "artifacts", "edges", "authorities", "tombstones", "changes"],
  "properties": {
    "kind": { "const": "request-contract" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["draft", "active", "complete", "incomplete"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "directive_ids", "obligation_atoms"],
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-[a-f0-9]{32}$" },
          "classification": { "enum": ["directive", "context", "conversation", "approval", "question", "internal", "authority"] },
          "directive_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "obligation_atoms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "directive_ids"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "text": { "type": "string", "minLength": 1 },
                "directive_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["classification"],
              "properties": { "classification": { "enum": ["directive", "approval", "authority"] } }
            },
            "then": {
              "properties": {
                "directive_ids": { "type": "array", "minItems": 1 },
                "obligation_atoms": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": { "directive_ids": { "type": "array", "minItems": 1 } }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "directives": {
      "type": "array",
      "items": { "$ref": "#/$defs/directive" }
    },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" },
      "allOf": [
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "directives_to_requirements" } } }, "minContains": 1 },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "requirements_to_use_cases" } } }, "minContains": 1 },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "use_cases_to_use_case_tests" } } }, "minContains": 1 },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "use_case_tests_to_features" } } }, "minContains": 1 },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "features_to_feature_tests" } } }, "minContains": 1 },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "feature_tests_to_implementations" } } }, "minContains": 1 },
        { "contains": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "implementations_to_evidence" } } }, "minContains": 1 }
      ]
    },
    "authorities": {
      "type": "array",
      "items": { "$ref": "#/$defs/authority" }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "directive_id", "state", "authority_id", "disposed_scope_ids", "statement"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "directive_id": { "$ref": "#/$defs/id" },
          "state": { "enum": ["superseded", "deferred", "abandoned"] },
          "authority_id": { "$ref": "#/$defs/id" },
          "disposed_scope_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "directive_id", "implementation_id", "evidence_id"],
        "properties": {
          "id": { "type": "string", "pattern": "^CHG-[a-f0-9]{32}$" },
          "directive_id": { "$ref": "#/$defs/id" },
          "implementation_id": { "$ref": "#/$defs/id" },
          "evidence_id": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,127}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "obligation_atom_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "obligation_atom_ids": { "$ref": "#/$defs/nonEmptyIds" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "obligation_atom_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "obligation_atom_ids": { "$ref": "#/$defs/nonEmptyIds" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "use_cases", "use_case_tests", "features", "feature_tests", "implementations", "evidence"],
      "properties": {
        "requirements": { "$ref": "#/$defs/nonEmptyIds" },
        "use_cases": { "$ref": "#/$defs/nonEmptyIds" },
        "use_case_tests": { "$ref": "#/$defs/nonEmptyIds" },
        "features": { "$ref": "#/$defs/nonEmptyIds" },
        "feature_tests": { "$ref": "#/$defs/nonEmptyIds" },
        "implementations": { "$ref": "#/$defs/nonEmptyIds" },
        "evidence": { "$ref": "#/$defs/nonEmptyIds" }
      }
    },
    "nonEmptyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "traceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "obligation_atom_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "obligation_atom_ids": { "$ref": "#/$defs/nonEmptyIds" }
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "obligation_atom_ids", "kind", "subject_id", "locator", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "obligation_atom_ids": { "$ref": "#/$defs/nonEmptyIds" },
        "kind": { "type": "string", "minLength": 1 },
        "subject_id": { "$ref": "#/$defs/id" },
        "locator": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "use_cases", "use_case_tests", "features", "feature_tests", "implementations", "evidence"],
      "properties": {
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/traceArtifact" } },
        "use_cases": { "type": "array", "items": { "$ref": "#/$defs/traceArtifact" } },
        "use_case_tests": { "type": "array", "items": { "$ref": "#/$defs/traceArtifact" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/traceArtifact" } },
        "feature_tests": { "type": "array", "items": { "$ref": "#/$defs/traceArtifact" } },
        "implementations": { "type": "array", "items": { "$ref": "#/$defs/traceArtifact" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceArtifact" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["directives_to_requirements", "requirements_to_use_cases", "use_cases_to_use_case_tests", "use_case_tests_to_features", "features_to_feature_tests", "feature_tests_to_implementations", "implementations_to_evidence"] },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" }
      }
    },
    "directive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "state", "source_ids", "targets", "acceptance_criteria"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "state": { "enum": ["pending", "active", "done", "superseded", "deferred", "abandoned"] },
        "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^SRC-[a-f0-9]{32}$" } },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
        "trace": { "$ref": "#/$defs/trace" },
        "authority_id": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["active", "done"] } } },
          "then": { "required": ["trace"] }
        },
        {
          "if": { "properties": { "state": { "enum": ["superseded", "deferred", "abandoned"] } } },
          "then": { "required": ["authority_id"] }
        }
      ]
    },
    "authorityReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "nonce", "issued_at", "expires_at", "resulting_scope_digest", "resulting_scope_epoch", "binding_epoch", "challenge", "presentation_digest", "target_directive_ids", "affected_source_ids", "affected_prior_ids", "replacement_ids", "tombstone_ids", "sign_count", "user_presence", "signature"],
      "properties": {
        "operation": { "enum": ["authorize_contract", "amend_scope_add", "amend_scope_replace", "supersede", "defer", "abandon", "resume"] },
        "nonce": { "type": "string", "minLength": 16 },
        "issued_at": { "type": "integer", "minimum": 0 },
        "expires_at": { "type": "integer", "minimum": 0 },
        "prior_scope_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resulting_scope_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resulting_scope_epoch": { "type": "integer", "minimum": 0 },
        "binding_epoch": { "type": "integer", "minimum": 1 },
        "challenge": { "type": "string", "minLength": 16 },
        "presentation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target_directive_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "affected_source_ids": { "type": "array", "items": { "type": "string", "pattern": "^SRC-[a-f0-9]{32}$" }, "uniqueItems": true },
        "affected_prior_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "replacement_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "tombstone_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "sign_count": { "type": "integer", "minimum": 1 },
        "user_presence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "non_exportable", "credential_id", "authenticator_kind"],
          "properties": {
            "present": { "const": true },
            "non_exportable": { "const": true },
            "credential_id": { "type": "string", "minLength": 1 },
            "authenticator_kind": { "enum": ["platform", "passkey", "hardware"] }
          }
        },
        "signature": { "type": "string", "minLength": 1 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "source_id", "source_digest", "target_directive_ids", "affected_source_ids", "affected_prior_ids", "replacement_ids", "tombstone_ids", "receipt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["authorize_contract", "amend_scope_add", "amend_scope_replace", "supersede", "defer", "abandon", "resume"] },
        "source_id": { "type": "string", "pattern": "^SRC-[a-f0-9]{32}$" },
        "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target_directive_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "affected_source_ids": { "type": "array", "items": { "type": "string", "pattern": "^SRC-[a-f0-9]{32}$" }, "uniqueItems": true },
        "affected_prior_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "replacement_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "tombstone_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "receipt": { "$ref": "#/$defs/authorityReceipt" }
      }
    }
  }
}
