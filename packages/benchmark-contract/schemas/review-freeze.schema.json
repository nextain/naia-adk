{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://naia.dev/schemas/benchmark/review-freeze.schema.json",
  "title":"Review Freeze Evidence",
  "type":"object","additionalProperties":false,
  "required":["contract_digest","prompt_digest","producer","attempt_ledger_digest","attempts","freeze"],
  "properties":{
    "contract_digest":{"$ref":"#/$defs/digest"},"prompt_digest":{"$ref":"#/$defs/digest"},"producer":{"$ref":"#/$defs/producer"},"attempt_ledger_digest":{"$ref":"#/$defs/digest"},"attempts":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/attempt"}},
    "freeze":{"type":"object","additionalProperties":false,"required":["schema_revision","contract_digest","ordered_clean_receipt_digests","ledger_digest","final_sequence","issue_scope_snapshot_digests","validator_revision","validator_result","created_at","freezer_principal","manifest_digest"],"properties":{"schema_revision":{"type":"string"},"contract_digest":{"$ref":"#/$defs/digest"},"ordered_clean_receipt_digests":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}},"ledger_digest":{"$ref":"#/$defs/digest"},"final_sequence":{"type":"integer","minimum":2},"issue_scope_snapshot_digests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/digest"}},"validator_revision":{"type":"string","minLength":1},"validator_result":{"const":"PASS"},"created_at":{"type":"string","format":"date-time"},"freezer_principal":{"type":"string","minLength":1},"manifest_digest":{"$ref":"#/$defs/digest"}}}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "producer":{"type":"object","additionalProperties":false,"required":["agent_principal","model_id","provider","execution_id","permission_scope","prompt_digest","input_contract_digest","produced_snapshot_digest"],"properties":{"agent_principal":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"execution_id":{"type":"string","minLength":1},"permission_scope":{"type":"string","minLength":1},"prompt_digest":{"$ref":"#/$defs/digest"},"input_contract_digest":{"$ref":"#/$defs/digest"},"produced_snapshot_digest":{"$ref":"#/$defs/digest"}}},
    "reviewer":{"type":"object","additionalProperties":false,"required":["agent_principal","model_id","provider","execution_id","permission_scope","reviewed_snapshot_digest","producer_context_isolated","identity_verified"],"properties":{"agent_principal":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"execution_id":{"type":"string","minLength":1},"permission_scope":{"const":"read-only"},"reviewed_snapshot_digest":{"$ref":"#/$defs/digest"},"producer_context_isolated":{"const":true},"identity_verified":{"const":true}}},
    "attempt":{"type":"object","additionalProperties":false,"required":["sequence","schema_revision","contract_digest","prompt_digest","reviewer","started_at","completed_at","status","verdict","blocking_count","material_count","non_material_count","findings_digest","receipt_digest"],"properties":{"sequence":{"type":"integer","minimum":1},"schema_revision":{"type":"string"},"contract_digest":{"$ref":"#/$defs/digest"},"prompt_digest":{"$ref":"#/$defs/digest"},"reviewer":{"$ref":"#/$defs/reviewer"},"started_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"},"status":{"enum":["CLEAN","DIRTY","INVALID","TOOL_FAILED"]},"verdict":{"enum":["CLEAN","DIRTY","INVALID","TOOL_FAILED"]},"blocking_count":{"type":"integer","minimum":0},"material_count":{"type":"integer","minimum":0},"non_material_count":{"type":"integer","minimum":0},"findings_digest":{"$ref":"#/$defs/digest"},"receipt_digest":{"$ref":"#/$defs/digest"}}}
  }
}
