  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "node":{"type":"object","additionalProperties":false,"required":["id","kind","semantic_scope","revision","content_digest","status","locator","incoming_edge_ids","outgoing_edge_ids"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._~:/#@-]*$"},"kind":{"enum":["directive","requirement","use_case","use_case_test","feature","feature_test","implementation","evidence"]},"semantic_scope":{"type":"string","pattern":"^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$"},"revision":{"type":"integer","minimum":1},"content_digest":{"$ref":"#/$defs/digest"},"status":{"enum":["active","superseded","tombstoned"]},"locator":{"type":"string","pattern":"^(?![A-Za-z]:|/)(?!.*\\\\)[^#]+(?:#[A-Za-z0-9._:-]+)?$"},"incoming_edge_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"outgoing_edge_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "edge":{"type":"object","additionalProperties":false,"required":["id","kind","from","from_revision","from_digest","to","to_revision","to_digest","status","evidence_locator","evidence_digest"],"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._~:/#@-]*$"},"kind":{"enum":["directives_to_requirements","requirements_to_use_cases","use_cases_to_use_case_tests","use_case_tests_to_features","features_to_feature_tests","feature_tests_to_implementations","implementations_to_evidence"]},"from":{"type":"string"},"from_revision":{"type":"integer","minimum":1},"from_digest":{"$ref":"#/$defs/digest"},"to":{"type":"string"},"to_revision":{"type":"integer","minimum":1},"to_digest":{"$ref":"#/$defs/digest"},"status":{"enum":["active","superseded","tombstoned"]},"evidence_locator":{"type":"string","pattern":"^(?![A-Za-z]:|/)(?!.*\\\\)[^#]+(?:#[A-Za-z0-9._:-]+)?$"},"evidence_digest":{"$ref":"#/$defs/digest"}}},
    "reservation":{"type":"object","additionalProperties":false,"required":["id","scope_digest","trace_revision","status","acquired_at","expires_at","conflict_result"],"properties":{"id":{"type":"string"},"scope_digest":{"$ref":"#/$defs/digest"},"trace_revision":{"type":"integer","minimum":1},"status":{"enum":["acquired","conflict","released","expired"]},"acquired_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"conflict_result":{"enum":["clear","conflict"]}}},
    "reservationEvent":{"type":"object","additionalProperties":false,"required":["sequence","kind","at","scope_digest","evidence_digest"],"properties":{"sequence":{"type":"integer","minimum":1},"kind":{"enum":["acquired","renewed","released","expired","conflict"]},"at":{"type":"string","format":"date-time"},"scope_digest":{"$ref":"#/$defs/digest"},"evidence_digest":{"$ref":"#/$defs/digest"}}},
    "translationAttempt":{"type":"object","additionalProperties":false,"required":["sequence","attempt_kind","route_id","model_revision","provider","status","tokens","cost","latency_ms","fallback_trigger","error_class"],"properties":{"sequence":{"type":"integer","minimum":1},"attempt_kind":{"enum":["primary","retry","fallback"]},"route_id":{"type":"string"},"model_revision":{"type":"string"},"provider":{"type":"string"},"status":{"enum":["pass","fail","invalid"]},"tokens":{"type":"integer","minimum":0},"cost":{"type":"number","minimum":0},"latency_ms":{"type":"integer","minimum":0},"fallback_trigger":{"type":"string"},"error_class":{"type":"string"}}}
  }
