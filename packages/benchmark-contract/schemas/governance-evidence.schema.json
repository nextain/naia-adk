  "properties":{
    "trace":{"type":"object","additionalProperties":false,"required":["schema_digest","snapshot_digest","nodes","edges","validator_revision","validator_result"],"properties":{"schema_digest":{"$ref":"#/$defs/digest"},"snapshot_digest":{"$ref":"#/$defs/digest"},"nodes":{"type":"array","minItems":8,"items":{"$ref":"#/$defs/node"}},"edges":{"type":"array","minItems":7,"items":{"$ref":"#/$defs/edge"}},"validator_revision":{"type":"string"},"validator_result":{"enum":["PASS","FAIL"]}}},
