{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://naia.dev/schemas/benchmark/asset-manifest.schema.json",
  "title":"Benchmark Asset Manifest",
  "type":"object","additionalProperties":false,
