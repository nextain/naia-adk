  "properties":{
    "id":{"type":"string"},"asset_type":{"enum":["fixture","scorer","holdout","calibration"]},"version":{"type":"string"},"source_revision":{"type":"string"},"source_locator":{"type":"string"},"fixture_digest":{"$ref":"#/$defs/digest"},"scorer_digest":{"$ref":"#/$defs/digest"},"producer_visible_input_digest":{"$ref":"#/$defs/digest"},"producer_visible_classification":{"enum":["public","synthetic_private","local_private"]},"sealed_oracle_digest":{"$ref":"#/$defs/digest"},"hidden_scorer_digest":{"$ref":"#/$defs/digest"},"oracle_access_policy_digest":{"$ref":"#/$defs/digest"},"access_log_digest":{"$ref":"#/$defs/digest"},"contamination_check_digest":{"$ref":"#/$defs/digest"},"license":{"type":"string"},"access_classification":{"type":"string"},"task_check_mapping_digest":{"$ref":"#/$defs/digest"},"isolation_verification_digest":{"$ref":"#/$defs/digest"},"decision":{"enum":["retained","repaired","rejected"]},"decision_reason":{"type":"string","minLength":1},"holdout_status":{"enum":["development","validation","sealed_unconsumed","consumed","retired"]},"lifecycle_digest":{"$ref":"#/$defs/digest"},"lifecycle_events":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["sequence","status","at","product_revision","evidence_digest"],"properties":{"sequence":{"type":"integer","minimum":1},"status":{"enum":["development","validation","sealed_unconsumed","consumed","retired"]},"at":{"type":"string","format":"date-time"},"product_revision":{"type":"string"},"evidence_digest":{"$ref":"#/$defs/digest"}}}},"producer_snapshot_bound_at":{"type":"string","format":"date-time"},"oracle_access_state":{"enum":["none","accessed"]},
    "oracle_first_access_at":{"type":"string","format":"date-time"},
