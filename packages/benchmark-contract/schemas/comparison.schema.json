{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://naia.dev/schemas/benchmark/comparison.schema.json",
  "title":"Paired Causal Comparison",
  "type":"object","additionalProperties":false,
  "required":["id","layer","comparison_scope","changed_variable","reference_run_id","candidate_run_id","routing_policy_id","statistical_plan_id","fixed_control_keys","paired_task_ids","paired_observations","calculation","quality","cost","owning_gate_ids","claim_status","claim_scope"],
  "properties":{
    "id":{"type":"string"},"layer":{"enum":["A_model_capability","B_agent_runtime","C_governance_harness"]},"comparison_scope":{"enum":["model_only","model_provider_adapter"]},"changed_variable":{"enum":["model_configuration","model_provider_adapter","agent_runtime_revision","governance_harness_revision","tool_adapter_revision"]},"reference_run_id":{"type":"string"},"candidate_run_id":{"type":"string"},"routing_policy_id":{"type":"string"},"statistical_plan_id":{"type":"string"},
    "fixed_control_keys":{"type":"array","minItems":8,"uniqueItems":true,"items":{"enum":["prompt_digest","context_digest","tool_set_digest","tool_schema_digest","platform_digest","scheduler_digest","scorer_set_digest","ordering_digest","task_set_digest","price_snapshot_digest"]}},
    "paired_task_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "paired_observations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["task_id","reference_quality","candidate_quality","reference_cost","candidate_cost"],"properties":{"task_id":{"type":"string"},"reference_quality":{"type":"number","minimum":0,"maximum":1},"candidate_quality":{"type":"number","minimum":0,"maximum":1},"reference_cost":{"type":"number","minimum":0},"candidate_cost":{"type":"number","minimum":0}}}},
    "calculation":{"type":"object","additionalProperties":false,"required":["revision","bootstrap_seed","input_digest","evidence_input_digest"],"properties":{"revision":{"type":"string","minLength":1},"bootstrap_seed":{"type":"integer","minimum":0,"maximum":4294967295},"input_digest":{"$ref":"#/$defs/digest"},"evidence_input_digest":{"$ref":"#/$defs/digest"}}},
    "quality":{"$ref":"#/$defs/qualityBound"},"cost":{"$ref":"#/$defs/costBound"},"owning_gate_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "claim_status":{"enum":["accepted","rejected","descriptive_only","invalid"]},"claim_scope":{"enum":["none","marginal_model_inference","benchmark_execution","total_operational"]}
  },
  "$defs":{"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"qualityBound":{"type":"object","additionalProperties":false,"required":["metric_id","delta_definition","estimate","lower_bound","upper_bound","ci_width","task_clustered","method"],"properties":{"metric_id":{"type":"string","minLength":1},"delta_definition":{"const":"candidate-reference"},"estimate":{"type":"number"},"lower_bound":{"type":"number"},"upper_bound":{"type":"number"},"ci_width":{"type":"number","minimum":0},"task_clustered":{"const":true},"method":{"const":"paired_bootstrap_10000"}}},"costBound":{"type":"object","additionalProperties":false,"required":["metric_id","delta_definition","estimate","lower_bound","upper_bound","ci_width","task_clustered","method"],"properties":{"metric_id":{"enum":["monetary","quota_units","local_compute_seconds","machine_occupancy_seconds","local_energy_wh"]},"delta_definition":{"const":"(candidate-reference)/reference"},"estimate":{"type":"number"},"lower_bound":{"type":"number"},"upper_bound":{"type":"number"},"ci_width":{"type":"number","minimum":0},"task_clustered":{"const":true},"method":{"const":"paired_bootstrap_10000"}}}}
}
