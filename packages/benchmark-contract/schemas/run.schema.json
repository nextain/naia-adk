{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naia.dev/schemas/benchmark/run.schema.json",
  "title": "Benchmark Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","contract_digest","task_set_digest","product_revision","dirty_state_digest","adapter_revision","agent_runtime_revision","governance_harness_revision","tool_adapter_revision","route_id","model","controls","price_snapshot","cost_scope","scheduled_task_ids","task_results","metrics","hard_gate_observations","evidence_snapshot_digest","started_at","completed_at"],
  "properties": {
    "id":{"type":"string","pattern":"^RUN-[A-Z0-9_-]{3,120}$"},
    "contract_digest":{"$ref":"#/$defs/digest"},
    "task_set_digest":{"$ref":"#/$defs/digest"},
    "product_revision":{"type":"string","minLength":1},
    "dirty_state_digest":{"$ref":"#/$defs/digest"},
    "adapter_revision":{"type":"string","minLength":1},
    "agent_runtime_revision":{"type":"string","minLength":1},
    "governance_harness_revision":{"type":"string","minLength":1},
    "tool_adapter_revision":{"type":"string","minLength":1},
    "route_id":{"type":"string","minLength":1},
    "model":{"type":"object","additionalProperties":false,"required":["exact_id","provider","configuration_digest"],"properties":{"exact_id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"configuration_digest":{"$ref":"#/$defs/digest"}}},
    "controls":{"type":"object","additionalProperties":false,"required":["prompt_digest","context_digest","tool_set_digest","tool_schema_digest","platform_digest","scheduler_digest","scorer_set_digest","ordering_digest"],"properties":{"prompt_digest":{"$ref":"#/$defs/digest"},"context_digest":{"$ref":"#/$defs/digest"},"tool_set_digest":{"$ref":"#/$defs/digest"},"tool_schema_digest":{"$ref":"#/$defs/digest"},"platform_digest":{"$ref":"#/$defs/digest"},"scheduler_digest":{"$ref":"#/$defs/digest"},"scorer_set_digest":{"$ref":"#/$defs/digest"},"ordering_digest":{"$ref":"#/$defs/digest"}}},
    "price_snapshot":{"type":"object","additionalProperties":false,"required":["digest","captured_at","effective_at","currency","plan","normalization_method"],"properties":{"digest":{"$ref":"#/$defs/digest"},"captured_at":{"type":"string","format":"date-time"},"effective_at":{"type":"string","format":"date-time"},"currency":{"type":"string","minLength":1},"plan":{"type":"string","minLength":1},"normalization_method":{"type":"string","minLength":1}}},
    "cost_scope":{"enum":["marginal_model_inference","benchmark_execution","total_operational"]},
    "scheduled_task_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "task_results":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/taskResult"}},
    "metrics":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/metric"}},
    "hard_gate_observations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gate"}},
    "evidence_snapshot_digest":{"$ref":"#/$defs/digest"},
    "started_at":{"type":"string","format":"date-time"},
    "completed_at":{"type":"string","format":"date-time"}
  },
  "$defs": {
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "state":{"enum":["measured","provider_proven_zero","not_applicable","unavailable","invalid"]},
    "observation":{"type":"object","additionalProperties":false,"required":["state","reason"],"properties":{"state":{"$ref":"#/$defs/state"},"value":{"type":"number","minimum":0},"evidence_digest":{"$ref":"#/$defs/digest"},"reason":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"state":{"enum":["measured","provider_proven_zero"]}}},"then":{"required":["value","evidence_digest"]}},{"if":{"properties":{"state":{"const":"provider_proven_zero"}}},"then":{"properties":{"value":{"const":0}}}},{"if":{"properties":{"state":{"enum":["not_applicable","unavailable","invalid"]}}},"then":{"not":{"anyOf":[{"required":["value"]},{"required":["evidence_digest"]}]}}}]},
    "cost":{"type":"object","additionalProperties":false,"required":["cached_input_tokens","uncached_input_tokens","output_tokens","reasoning_tokens","retries","wall_time_ms","fallbacks","escalations","terminal_failure_consumption","monetary","quota_units"],"properties":{"cached_input_tokens":{"$ref":"#/$defs/observation"},"uncached_input_tokens":{"$ref":"#/$defs/observation"},"output_tokens":{"$ref":"#/$defs/observation"},"reasoning_tokens":{"$ref":"#/$defs/observation"},"retries":{"$ref":"#/$defs/observation"},"wall_time_ms":{"$ref":"#/$defs/observation"},"fallbacks":{"$ref":"#/$defs/observation"},"escalations":{"$ref":"#/$defs/observation"},"terminal_failure_consumption":{"$ref":"#/$defs/observation"},"monetary":{"$ref":"#/$defs/observation"},"quota_units":{"$ref":"#/$defs/observation"},"local_compute_seconds":{"$ref":"#/$defs/observation"},"machine_occupancy_seconds":{"$ref":"#/$defs/observation"},"local_energy_wh":{"$ref":"#/$defs/observation"}}},
    "taskResult":{"type":"object","additionalProperties":false,"required":["task_id","run_index","status","outcome_class","reason","evidence_digest","cost"],"properties":{"task_id":{"type":"string"},"run_index":{"type":"integer","minimum":1},"status":{"enum":["valid_pass","valid_fail","invalid"]},"outcome_class":{"enum":["task_result","timeout","infrastructure_failure","tool_incompatibility","scorer_failure"]},"reason":{"type":"string","minLength":1},"evidence_digest":{"$ref":"#/$defs/digest"},"cost":{"$ref":"#/$defs/cost"}},"allOf":[{"if":{"properties":{"outcome_class":{"enum":["timeout","infrastructure_failure","tool_incompatibility","scorer_failure"]}}},"then":{"properties":{"status":{"const":"invalid"}}}}]},
    "metric":{"type":"object","additionalProperties":false,"required":["id","suite_id","calculation_kind","formula_revision","unit","numerator_definition","denominator_definition","numerator","denominator","required_for_acceptance","state","reason","input_digest","evidence_digest"],"properties":{"id":{"type":"string"},"suite_id":{"type":"string"},"calculation_kind":{"enum":["task_pass_rate","task_valid_rate","external_scorer"]},"formula_revision":{"type":"string"},"unit":{"type":"string"},"numerator_definition":{"type":"string","minLength":1},"denominator_definition":{"type":"string","minLength":1},"numerator":{"type":"number"},"denominator":{"type":"number","exclusiveMinimum":0},"required_for_acceptance":{"type":"boolean"},"state":{"$ref":"#/$defs/state"},"reason":{"type":"string","minLength":1},"input_digest":{"$ref":"#/$defs/digest"},"evidence_digest":{"$ref":"#/$defs/digest"}}},
    "gate":{"type":"object","additionalProperties":false,"required":["id","task_ids","owning_layers","status","evidence_digest","reason"],"properties":{"id":{"type":"string","pattern":"^HG-[A-Z0-9-]+$"},"task_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"owning_layers":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["A_model_capability","B_agent_runtime","C_governance_harness"]}},"status":{"enum":["GREEN","RED","invalid","unavailable"]},"evidence_digest":{"$ref":"#/$defs/digest"},"reason":{"type":"string","minLength":1}}}
  }
}
