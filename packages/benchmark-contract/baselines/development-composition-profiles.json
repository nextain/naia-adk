 "guards": {
  "_doc": "Risk grades are defined in .agents/context/terminology.yaml under definitions.delegation: the grade measures the cost of undoing the task, not its difficulty, and a brief accepts low and medium only. These conditions apply by tier in both layers: the role selector and the delegation spawn gate in .codex/hooks/subagent-spawn-guard.cjs derive them from the selected profile's tier for that role. A flagship binding is exempt, and the optional external worker keeps its signed-receipt qualification instead. Bounded roles map to bounded_worker and generic_worker maps to mechanical_worker.",
  "risk_floor": {
   "_doc": "The declared grade is the brief author's own word, so the ceilings above only constrain a caller that already agrees with them. These rules derive a floor from what can be observed in the brief and the parent contract, and a declaration below its floor is refused. They cannot prove a grade is right; they stop it from being lower than the evidence allows. A path leaving the project root is not among them because the ownership pattern check rejects absolute paths and parent references before this runs, and a rule that cannot be reached is worse than no rule. The floor also applies on the unbound operator opt-in path, so that marker is not an unnamed way around it.",
   "missing_validator_floor": "medium",
   "authority_path_floor": "medium",
   "authority_paths": [
    ".agents/context/",
    ".agents/hooks/",
    ".agents/session-contracts/",
    ".claude/hooks/",
    ".codex/hooks/",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md"
   ]
  },
  "guard_relaxation": {
   "_doc": "A guard exists to keep unbounded work from running unattended, not to stop authorized work. When a condition blocks a task the owner judges safe, it can be relaxed explicitly and visibly rather than worked around: name the conditions in the bound contract's subagent_policy.guard_relaxations, or for one session in the override environment variable. Silent bypass is never a path; an unrecognized name is rejected.",
   "allowed": [
    "exact_validator",
    "risk_ceiling",
    "bounded_scope",
    "risk_floor"
   ],
   "contract_field": "guard_relaxations",
   "override_env": "CODEX_DEVELOPMENT_GUARD_RELAXATIONS"
  },
  "bounded_worker": {
   "requires_bounded_scope": true,
   "maximum_risk": "medium",
   "requires_exact_validator": true,
   "tier_fallback_binding": null,
   "fallback_binding": null
  },
  "mechanical_worker": {
   "requires_exact_validator": true,
   "requires_bounded_scope": true,
   "maximum_risk": "low",
   "fallback_binding": null
  },
  "review": {
   "different_session_required": true,
   "different_execution_required": true,
   "prefer_different_binding_from_producer": true,
   "prefer_different_provider_from_producer": true,
   "fail_closed_without_independent_execution_identity": true,
   "fresh_session_required": true,
   "followup_reuse_forbidden": true,
   "runtime_enforcer": ".codex/hooks/subagent-spawn-guard.cjs"
  },
  "flagship_specialist": {
   "roles": [
    "analysis",
    "design",
    "review"
   ],
   "different_session_required": true,
   "different_execution_required": true,
   "fail_closed_without_independent_execution_identity": true,
