   "runtime_enforcer": ".codex/hooks/subagent-spawn-guard.cjs"
  },
  "cross_provider_review": {
   "_doc": "Host families whose review tier must resolve to a provider other than the bounded worker's provider.",
   "required_for_host_families": [
    "mixed"
   ]
  }
 },
