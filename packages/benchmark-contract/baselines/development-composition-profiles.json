 "profiles": [
  {
   "id": "control",
   "activation": "active",
   "reasoning_effort": "medium",
   "purpose": "Manually selected quality/reference and reversible rollback profile; never an automatic per-task model fallback",
   "assignments": {
    "orchestrator": "sol",
    "integrator": "sol",
    "bounded_worker": "sol",
    "mechanical_worker": "sol",
    "tester": "sol",
    "reviewer_pool": [
     "sol"
    ]
   }
  },
  {
   "id": "balanced",
   "purpose": "Default Codex profile: Luna Max leads L3/L2, Luna executes bounded work, and separate Sol Medium sessions analyze, design, and review",
   "assignments": {
    "orchestrator": "luna",
    "integrator": "luna",
    "bounded_worker": "luna",
    "mechanical_worker": "luna",
    "tester": "luna",
    "reviewer_pool": [
     "sol"
    ]
   }
  },
  {
   "id": "economy",
   "purpose": "Experimental extension of balanced using Luna only behind exact validation",
   "assignments": {
    "orchestrator": "luna",
    "integrator": "luna",
    "bounded_worker": "luna",
    "mechanical_worker": "luna",
    "tester": "luna",
    "reviewer_pool": [
     "sol"
    ]
   }
  },
  {
   "id": "delegated",
   "activation": "disabled_until_runtime_issuance_and_verification",
   "purpose": "Optional additional-provider profile: Sol retains orchestration and integration while a replaceable qualified binding performs bounded implementation",
   "assignments": {
    "orchestrator": "sol",
    "integrator": "sol",
    "bounded_worker": "implementation_worker",
    "mechanical_worker": "luna",
    "tester": "luna",
    "reviewer_pool": [
     "sol"
    ]
   }
  },
  {
   "id": "grok-balanced",
   "purpose": "Grok-only balanced default: Grok 4.6 medium leads L3/L2 and bounded implementation, 4.6 high analyzes and designs, and light 4.6 low handles translation and verification",
   "assignments": {
    "orchestrator": "grok_workhorse",
    "integrator": "grok_workhorse",
    "bounded_worker": "grok_workhorse",
    "mechanical_worker": "grok_workhorse",
    "tester": "grok_light",
    "reviewer_pool": [
     "grok_flagship"
    ]
   }
  }
 ],
