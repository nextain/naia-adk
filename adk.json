{
  "schema_version": "1.0",
  "adk_version": "2.0.0",
  "id": "naia-adk",
  "name": "Naia ADK — Unified Framework Base",
  "role": "framework_base",
  "kind": "user",
  "supported_kinds": [
    "user",
    "agent",
    "project",
    "group"
  ],
  "owner": "nextain",
  "responsible_human": "luke",
  "base_commit": "0.1.0",
  "paths": {
    "rules": "rules",
    "data": "data",
    "keys": "keys",
    "skills": "skills"
  },
  "isolation": {
    "keys_isolated": true,
    "keys_gitignored": true,
    "keys_never_linked": true
  },
  "links": [],
  "permissions": {
    "allowed_roots": [
      "rules",
      "data",
      "skills",
      "templates",
      "schemas",
      "scripts",
      "docs"
    ],
    "denied_roots": [
      "keys",
      "data-private",
      "naia-settings/.keys"
    ],
    "actions": [
      "read",
      "write",
      "export"
    ]
  },
  "user_config": {
    "shell": {
      "workspace_root": ".",
      "theme": "dark",
      "voice_enabled": true,
      "avatar_display": true
    },
    "devices": [],
    "accounts": []
  }
}
