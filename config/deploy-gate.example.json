{
  "schema": "deploy-gate/v1",
  "approver": {
    "discordUserId": "<승인자 디스코드 사용자 번호(17~20자리 Snowflake)>"
  },
  "discord": {
    "instances": [
      "default"
    ]
  },
  "plugin": "./config/deploy-gate-plugin.cjs",
  "prodPatterns": [
    {
      "pattern": "\\bmy-custom-deploy\\b.*--prod\\b",
      "service": "custom:service:my-app-prod",
      "label": "커스텀 운영 배포"
    }
  ],
  "sshAlwaysGated": [
    {
      "pattern": "(?:^|@)prod-bastion\\b",
      "service": "vm:ssh:prod-bastion"
    }
  ],
  "testHostsNote": "비운영(시험) 기기 호스트·IP 목록(문자열 배열, 소문자·끝 점 정규화, 정확히 일치하는 이름만 비운영으로 보며 원격 본문은 다시 분류)",
  "testHosts": [],
  "readOnlyScriptsNote": "사람 승인 코드 없이 반복 실행할 kind=ops 고정 읽기 대본 목록([{sha256, path, service, note}]). service 와일드카드(*, ? 등) 금지, 설정·대본 모두 심볼릭 링크 없이 git 추적 및 HEAD 블롭과 일치하고 적대 리뷰 영수증에 동일 항목·대본 지문이 묶였으며 허용된 정확한 명령 꼴일 때만 적용",
  "readOnlyScripts": [],
  "services": {
    "azure:containerapp:my-app-prod": {
      "label": "운영 웹 컨테이너 앱",
      "requireDeployGate": true,
      "requireUiGate": false,
      "allowOps": true,
      "allowRollback": true,
      "opsCommandPattern": "\\baz\\s+containerapp\\s+(?:update\\b(?![^\\n]*--image\\b)|ingress\\b|revision\\b)",
      "commandMustContain": [
        "my-app-prod"
      ]
    },
    "gcp:cloudrun:my-api-prod": {
      "label": "운영 Cloud Run API",
      "requireDeployGate": true,
      "allowOps": true,
      "allowRollback": true
    },
    "azure:vm:my-gateway-prod": {
      "label": "Gateway production runner",
      "requireDeployGate": true,
      "requireReadiness": true,
      "gatewayRunner": {
        "subscriptionId": "00000000-0000-0000-0000-000000000000",
        "location": "koreacentral",
        "acrName": "myregistry",
        "imageRepo": "myregistry.azurecr.io/my-org/gateway",
        "environments": {
          "prod": {
            "resourceGroup": "rg-my-gateway-prod",
            "vmName": "my-gateway-prod"
          },
          "dev": {
            "resourceGroup": "rg-my-gateway-dev",
            "vmName": "my-gateway-dev"
          }
        }
      },
      "allowedCommands": [
        "^bash /[A-Za-z0-9_./-]+/launch-local\\.sh prod [0-9]{8}T[0-9]{6}Z-[a-z0-9-]{1,32} [A-Za-z0-9_.-]{1,128} sha256:[a-f0-9]{64} sha256:[a-f0-9]{64} [A-Za-z0-9_.-]{1,128}(?: backup(?: (?:-|azure-tts-key-v1(?:,azure-tts-region-v1)?(?:,app-signing-public-key-v1)?|azure-tts-region-v1(?:,app-signing-public-key-v1)?|app-signing-public-key-v1))?| cleanup(?: -)?)?$",
        "^bash /[A-Za-z0-9_./-]+/operation-local\\.sh prod [0-9]{8}T[0-9]{6}Z-[a-z0-9-]{1,32} (?:deploy|verify|status|rollback)$",
        "^bash /[A-Za-z0-9_./-]+/status-local\\.sh prod [0-9]{8}T[0-9]{6}Z-[a-z0-9-]{1,32}(?: (?:recent|full-log|env-names|installed-hashes))?$",
        "^bash /[A-Za-z0-9_./-]+/rollback-local\\.sh prod [0-9]{8}T[0-9]{6}Z-[a-z0-9-]{1,32}$"
      ],
      "requiredFiles": [
        "scripts/gateway-runner/launch-local.sh",
        "scripts/gateway-runner/operation-local.sh",
        "scripts/gateway-runner/status-local.sh",
        "scripts/gateway-runner/rollback-local.sh",
        "scripts/gateway-runner/naia-gw-deploy.sh",
        "scripts/gateway-runner/gateway-operation.py"
      ]
    }
  }
}
