{
  "version": 1,
  "provider": {
    "type": "discord",
    "token_env": "DISCORD_BOT_TOKEN",
    "guild_id": "GUILD_ID",
    "max_threads": 25
  },
  "roles": [
    {
      "role": "secretary",
      "user_ids": ["BOT_USER_ID"],
      "role_ids": ["BOT_ROLE_ID"],
      "relay_ids": [],
      "channels": ["CHANNEL_ID"],
      "direct_channels": [],
      "answered_by_any_role_post_after": false,
      "human_ids": ["HUMAN_USER_ID"],
      "report": {
        "every_min": 60,
        "channel": "CHANNEL_ID"
      },
      "check_unrecorded_human": true
    }
  ],
  "due_timer": { "enabled": false, "horizon_hours": 24 },
  "channel_read_interval_ms": 300,
  "human_wait": {
    "after_min": 15,
    "question_patterns": [
      "[?？](?:\\s|$)",
      "될까요",
      "(?:골라\\s*주시면|고르시면)",
      "(?:답변|응답|승인)을?\\s*기다리겠습니다",
      "(?:시각|시간|선택|승인|결정).*(?:알려|말씀)\\s*주시면"
    ]
  }
}
